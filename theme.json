{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "color": {
            "palette": [
                {
                    "slug": "primary",
                    "color": "#1e293b",
                    "name": "Primary"
                },
                {
                    "slug": "secondary",
                    "color": "#bef264",
                    "name": "Secondary"
                },
                {
                    "slug": "tertiary",
                    "color": "#7dd3fc",
                    "name": "Tertiary"
                },
                {
                    "slug": "accent",
                    "color": "#84cc16",
                    "name": "Accent"
                },
                {
                    "slug": "text",
                    "color": "#687e9d",
                    "name": "Text"
                },
                {
                    "slug": "background",
                    "color": "#f5f9ff",
                    "name": "Background"
                },
                {
                    "slug": "white",
                    "color": "#ffffff",
                    "name": "White"
                },
                {
                    "slug": "dark",
                    "color": "#334155",
                    "name": "Dark"
                }
            ],
            "gradients": [
                {
                    "slug": "primary-to-dark",
                    "gradient": "linear-gradient(135deg, #1e293b 0%, #334155 100%)",
                    "name": "Primary to Dark"
                },
                {
                    "slug": "accent-to-secondary",
                    "gradient": "linear-gradient(135deg, #84cc16 0%, #bef264 100%)",
                    "name": "Accent to Secondary"
                }
            ]
        },
        "typography": {
            "fontFamilies": [
                {
                    "fontFamily": "'Noto Sans JP', sans-serif",
                    "slug": "noto-sans-jp",
                    "name": "Noto Sans JP"
                },
                {
                    "fontFamily": "'Noto Serif JP', serif",
                    "slug": "noto-serif-jp",
                    "name": "Noto Serif JP"
                },
                {
                    "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                    "slug": "system",
                    "name": "System"
                }
            ],
            "fontSizes": [
                {
                    "slug": "small",
                    "size": "0.875rem",
                    "name": "Small"
                },
                {
                    "slug": "medium",
                    "size": "1rem",
                    "name": "Medium"
                },
                {
                    "slug": "large",
                    "size": "1.25rem",
                    "name": "Large"
                },
                {
                    "slug": "x-large",
                    "size": "1.5rem",
                    "name": "Extra Large"
                },
                {
                    "slug": "xx-large",
                    "size": "2rem",
                    "name": "Huge"
                }
            ]
        },
        "spacing": {
            "units": ["px", "em", "rem", "%", "vw", "vh"]
        },
        "layout": {
            "contentSize": "1024px",
            "wideSize": "1280px"
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--background)",
            "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--system)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "lineHeight": "1.5"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--primary)"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--tertiary)"
                    }
                }
            },
            "heading": {
                "typography": {
                    "fontWeight": "700"
                },
                "color": {
                    "text": "var(--wp--preset--color--primary)"
                }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--primary)",
                    "text": "var(--wp--preset--color--white)"
                },
                ":hover": {
                    "color": {
                        "background": "var(--wp--preset--color--dark)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--medium)"
                }
            }
        },
        "blocks": {
            "core/quote": {
                "border": {
                    "left": {
                        "color": "var(--wp--preset--color--accent)",
                        "width": "4px",
                        "style": "solid"
                    }
                },
                "spacing": {
                    "padding": {
                        "left": "1.5rem"
                    }
                }
            }
        }
    }
}
